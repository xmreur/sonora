# Maintainer: you
pkgname=sonora
pkgver=0.1.8
pkgrel=1
pkgdesc="Native Apple Music client for Linux (egui UI, in-process playback)"
arch=('x86_64')
url="https://example.invalid/apple-music-linux-client"
license=('MIT')
depends=('gstreamer' 'gst-plugins-good' 'gst-plugins-bad' 'gst-libav' 'alsa-lib'
         'libxkbcommon' 'wayland' 'libx11' 'hicolor-icon-theme')
makedepends=('rust' 'cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked -p sonora
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/sonora" "$pkgdir/usr/bin/sonora"
  install -Dm644 "packaging/sonora.desktop" \
    "$pkgdir/usr/share/applications/sonora.desktop"
  install -Dm644 "crates/sonora/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/sonora.png"
  install -Dm644 "crates/sonora/icons/64x64.png" \
    "$pkgdir/usr/share/icons/hicolor/64x64/apps/sonora.png"
  install -Dm644 "crates/sonora/icons/32x32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/sonora.png"
}
